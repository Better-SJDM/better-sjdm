---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceSearch from "../../components/site/ServiceSearch.astro";
const services = (await getCollection("services")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Services">
  <section class="page-header">
    <div class="container">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Services</span>
      </nav>
      <h1>Find a service</h1>
      <p class="page-description">Explore the directory by name or category.</p>
    </div>
  </section>
  <div class="content">
    {services.some(({ data }) => data.sample) && (
      <div class="notice">
        <strong>Example content.</strong> Entries marked as fictional do not
        describe real services.
      </div>
    )}
    <ServiceSearch services={services} />
  </div>
</BaseLayout>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-stroke);
    background: var(--background-image-civic-soft);
  }
  .container {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-brand);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .eyebrow span {
    width: 27px;
    height: 2px;
    background: var(--color-brand);
  }
  .page-header h1 {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-header h1 em {
    color: var(--color-brand);
    font-style: normal;
  }
  .page-description {
    max-width: 65ch;
    margin-top: 0.85rem;
    color: var(--color-muted-copy);
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .content {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
    padding: 2rem 0 3.5rem;
  }
  .notice {
    margin-bottom: 1.5rem;
    padding: 1rem;
    border-left: 3px solid var(--color-notice-border);
    background: var(--color-notice);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  @media (min-width: 521px) {
    .container {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
    .content {
      width: min(calc(100% - 2.5rem), var(--container-site));
      padding-block: 3rem 5rem;
    }
  }
</style>
