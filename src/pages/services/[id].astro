---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() {
  return (await getCollection("services")).map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}
const { service } = Astro.props;
const { data } = service;
---

<BaseLayout title={data.title}>
  <section class="border-b border-stroke bg-civic-soft py-12 min-[521px]:py-16 [&_h1]:my-6 [&_h1]:text-[clamp(2.5rem,5vw,4rem)] [&_h1]:leading-[1.04] [&_h1]:font-extrabold [&_h1]:tracking-[-0.055em] [&_em]:not-italic [&_em]:text-brand [&>div>p:not(.eyebrow)]:max-w-[31rem] [&>div>p:not(.eyebrow)]:text-[1.05rem] [&>div>p:not(.eyebrow)]:leading-[1.8] [&>div>p:not(.eyebrow)]:text-muted-copy">
    <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)]">
      <a
        class="mb-6 inline-block text-sm font-bold text-brand no-underline hover:underline"
        href="/services/"
      >
        ← All services
      </a>
      <p class="eyebrow flex items-center gap-3 text-[0.7rem] font-extrabold tracking-[0.16em] text-brand [&>span]:h-0.5 [&>span]:w-[27px] [&>span]:bg-brand">
        <span></span> {data.category.toUpperCase()}
      </p>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
    </div>
  </section>
  <section class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] max-w-[850px] pt-12 pb-20">
    <div class="rounded-[0.6rem] border border-stroke bg-civic-card p-[clamp(1.3rem,4vw,2.5rem)] [&_h2]:mb-4 [&_h2]:text-xl [&_h2]:font-bold [&_p]:mb-4 [&_p]:leading-[1.8] [&_p]:text-muted-copy">
      {data.sample && (
        <div class="mb-6 border-l-[3px] border-notice-border bg-notice p-4 text-sm leading-relaxed">
          <strong>Fictional example.</strong> This is not a real service or
          source.
        </div>
      )}
      <h2>Service information</h2>
      <p>{data.description}</p>
      {data.contact && (
        <p>
          <strong>Contact:</strong> {data.contact}
        </p>
      )}
      {data.location && (
        <p>
          <strong>Location:</strong> {data.location}
        </p>
      )}
      <div class="mt-8 border-t border-stroke pt-4 [&_a]:text-brand">
        <p>
          <strong>Source:</strong>{" "}
          <a href={data.source}>
            {data.sample ? "Example source" : "View source"}
          </a>
        </p>
        <p>
          <strong>Last verified:</strong>{" "}
          <time datetime={data.verified.toISOString().slice(0, 10)}>
            {data.verified.toLocaleDateString("en-PH", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
          {data.sample && " (example date)"}
        </p>
      </div>
      <a
        class="text-sm font-bold text-brand no-underline hover:underline"
        href="/about/#contribute"
      >
        Suggest a correction →
      </a>
    </div>
  </section>
</BaseLayout>
