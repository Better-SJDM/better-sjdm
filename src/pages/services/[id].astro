---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
export async function getStaticPaths() {
  return (await getCollection("services")).map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}
const { service } = Astro.props;
const { data } = service;
---

<BaseLayout title={data.title}>
  <section class="page-header">
    <div class="container">
      <a class="text-link back-link" href="/services/">
        ← All services
      </a>
      <h1>{data.title}</h1>
      <p class="page-description">{data.description}</p>
    </div>
  </section>
  <section class="content">
    <div class="content-card">
      {data.sample && (
        <div class="notice">
          <strong>Fictional example.</strong> This is not a real service or
          source.
        </div>
      )}
      <h2>Service information</h2>
      <p>{data.description}</p>
      {data.eligibility && (
        <>
          <h2>Who can use this service</h2>
          <p>{data.eligibility}</p>
        </>
      )}
      {data.requirements && data.requirements.length > 0 && (
        <>
          <h2>What to prepare</h2>
          <p>Check off the items as you prepare them.</p>
          <ul class="requirements">
            {data.requirements.map((requirement) => (
              <li>
                <label>
                  <input type="checkbox" /> {requirement}
                </label>
              </li>
            ))}
          </ul>
        </>
      )}
      {data.steps && data.steps.length > 0 && (
        <>
          <h2>What to do</h2>
          <ol>
            {data.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </>
      )}
      {data.fees && (
        <p>
          <strong>Fees:</strong> {data.fees}
        </p>
      )}
      {data.processingTime && (
        <p>
          <strong>Processing time:</strong> {data.processingTime}
        </p>
      )}
      {data.contact && (
        <p>
          <strong>Contact:</strong> {data.contact}
        </p>
      )}
      {data.location && (
        <p>
          <strong>Location:</strong> {data.location}
        </p>
      )}
      <div class="source">
        <p>
          <strong>Source:</strong>{" "}
          <a href={data.source}>
            {data.sample ? "Example source" : "View source"}
          </a>
        </p>
        <p>
          <strong>Last verified:</strong>{" "}
          <time datetime={data.verified.toISOString().slice(0, 10)}>
            {data.verified.toLocaleDateString("en-PH", {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
          {data.sample && " (example date)"}
        </p>
      </div>
      <a class="text-link" href="/about/#contribute">
        Suggest a correction
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .requirements {
    padding: 0;
    list-style: none;
  }
  .requirements label {
    display: flex;
    align-items: start;
    gap: 0.75rem;
    padding-block: 0.5rem;
  }
  .requirements input {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
  }
  li {
    margin-block: 0.5rem;
  }
  @media print {
    .back-link {
      display: none;
    }
    .content-card {
      border: 0;
      padding: 0;
    }
  }
  .page-header {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--color-stroke);
    background: var(--background-image-civic-soft);
  }
  .container {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-brand);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .eyebrow span {
    width: 27px;
    height: 2px;
    background: var(--color-brand);
  }
  .page-header h1 {
    margin: 1.5rem 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.055em;
  }
  .page-header h1 em {
    color: var(--color-brand);
    font-style: normal;
  }
  .page-description {
    max-width: 31rem;
    color: var(--color-muted-copy);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .content {
    width: min(calc(100% - 2rem), 850px);
    margin-inline: auto;
    padding: 2rem 0 3.5rem;
  }
  .content-card {
    padding: clamp(1.3rem, 4vw, 2.5rem);
    border: 1px solid var(--color-stroke);
    border-radius: 0.6rem;
    background: var(--background-image-civic-card);
  }
  .content-card h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .content-card h2:not(:first-child) {
    margin-top: 2.5rem;
  }
  .content-card p {
    margin-bottom: 1rem;
    color: var(--color-muted-copy);
    line-height: 1.8;
  }
  .notice {
    margin-bottom: 1.5rem;
    padding: 1rem;
    border-left: 3px solid var(--color-notice-border);
    background: var(--color-notice);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .text-link {
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .source {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-stroke);
  }
  .source a {
    color: var(--color-brand);
  }
  @media (min-width: 521px) {
    .page-header {
      padding-block: 4rem;
    }
    .container {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
    .content {
      width: min(calc(100% - 2.5rem), 850px);
      padding-block: 3rem 5rem;
    }
  }
</style>
