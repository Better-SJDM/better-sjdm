---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  cityEmergencyContacts,
  hospitalContacts,
  utilityContacts,
  nationalContacts,
  barangayContacts,
} from "../data/emergency-contacts";
---

<BaseLayout
  title="Emergency Hotline"
  description="Verified emergency hotlines, hospitals, utility services, and 62 barangay contacts for San Jose del Monte, Bulacan."
>
  <section class="page-header">
    <div class="container">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Emergency Hotlines</span>
      </nav>
      <h1>Emergency Hotlines</h1>
      <p>
        In an immediate life safety emergency, call 911 or the San Jose del
        Monte CDRRMO Command Center. State your name, exact landmark or street,
        and what assistance is required.
      </p>
    </div>
  </section>

  <!-- Urgent Quick-Dial Ribbon -->
  <section class="quick-dial-section" aria-label="Urgent quick-dial hotlines">
    <div class="container">
      <div class="quick-dial-card">
        <div class="quick-dial-header">
          <span class="pulse-indicator" aria-hidden="true"></span>
          <h2>Immediate Emergency Dispatch</h2>
          <span class="quick-badge">24/7 Priority Lines</span>
        </div>
        <p class="quick-lead">
          Tap any number below to dial direct emergency services in San Jose del
          Monte:
        </p>
        <div class="quick-dial-grid">
          <a
            class="dial-btn dial-national"
            href="tel:911"
            aria-label="Call 911 National Emergency Hotline"
          >
            <span class="dial-name">Emergency 911</span>
            <span class="dial-num">911</span>
            <span class="dial-sub">Police, Fire, Ambulance</span>
          </a>

          <a
            class="dial-btn"
            href="tel:0443066234"
            aria-label="Call CDRRMO Rescue Landline at (044) 306-6234"
          >
            <span class="dial-name">CDRRMO Rescue (Landline)</span>
            <span class="dial-num">(044) 306-6234</span>
            <span class="dial-sub">City Disaster Operations Center</span>
          </a>

          <a
            class="dial-btn"
            href="tel:09552067200"
            aria-label="Call CDRRMO Rescue Mobile at 0955-206-7200"
          >
            <span class="dial-name">CDRRMO Rescue (Mobile)</span>
            <span class="dial-num">0955-206-7200</span>
            <span class="dial-sub">24/7 Flood & Medical Dispatch</span>
          </a>

          <a
            class="dial-btn"
            href="tel:0448158512"
            aria-label="Call PNP Police Station at (044) 815-8512"
          >
            <span class="dial-name">City Police Station (PNP)</span>
            <span class="dial-num">(044) 815-8512</span>
            <span class="dial-sub">CSJDM Police Headquarters</span>
          </a>

          <a
            class="dial-btn"
            href="tel:09323732444"
            aria-label="Call Bureau of Fire Protection at 0932-373-2444"
          >
            <span class="dial-name">Fire Protection (BFP)</span>
            <span class="dial-num">0932-373-2444</span>
            <span class="dial-sub">CSJDM Central Fire Station</span>
          </a>

          <a
            class="dial-btn"
            href="tel:0443237123"
            aria-label="Call Ospital ng Lungsod ng San Jose del Monte at (044) 323-7123"
          >
            <span class="dial-name">OLSJDM Public Hospital</span>
            <span class="dial-num">(044) 323-7123</span>
            <span class="dial-sub">24/7 Public Emergency Room</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Directory -->
  <section
    class="container directory-section"
    aria-label="Directory of contacts"
  >
    <!-- Search and Controls -->
    <div class="directory-controls">
      <div class="search-box">
        <label for="emergencySearch" class="visually-hidden">
          Search emergency contacts or barangays
        </label>
        <div class="search-input-wrap">
          <svg
            class="search-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="emergencySearch"
            placeholder="Search by name, service, office, or barangay (e.g., hospital, fire, Muzon, water, tanod)..."
            autocomplete="off"
          />
          <button
            type="button"
            id="clearSearch"
            class="clear-btn"
            aria-label="Clear search"
            hidden
          >
            &times;
          </button>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div
        class="filter-tabs"
        role="tablist"
        aria-label="Filter contact categories"
      >
        <button
          type="button"
          class="tab-btn active"
          role="tab"
          aria-selected="true"
          data-filter="all"
        >
          All Contacts
        </button>
        <button
          type="button"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          data-filter="city"
        >
          Citywide & Rescue
        </button>
        <button
          type="button"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          data-filter="hospital"
        >
          Hospitals
        </button>
        <button
          type="button"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          data-filter="utility"
        >
          Utilities
        </button>
        <button
          type="button"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          data-filter="barangay"
        >
          Barangays (62)
        </button>
        <button
          type="button"
          class="tab-btn"
          role="tab"
          aria-selected="false"
          data-filter="national"
        >
          National
        </button>
      </div>

      <!-- District Sub-filter (Shown when Barangay tab or search is active) -->
      <div id="districtFilters" class="district-filters" hidden>
        <span class="district-label">Filter District:</span>
        <button
          type="button"
          class="subtab-btn active"
          data-district="all"
          aria-pressed="true"
        >
          All (62)
        </button>
        <button
          type="button"
          class="subtab-btn"
          data-district="1"
          aria-pressed="false"
        >
          District 1 (26)
        </button>
        <button
          type="button"
          class="subtab-btn"
          data-district="2"
          aria-pressed="false"
        >
          District 2 (36)
        </button>
      </div>

      <!-- Live Results Counter -->
      <div class="results-meta" aria-live="polite">
        <span id="resultsCount">Showing all contacts</span>
      </div>
    </div>

    <!-- Contact Cards Grid -->
    <div id="contactsGrid" class="contacts-grid">
      <!-- CITYWIDE CONTACTS -->
      {cityEmergencyContacts.map((contact) => (
        <article
          class="contact-card"
          data-category="city"
          data-search={`${contact.name} ${contact.description} ${contact.number} ${contact.address || ""} ${contact.email || ""}`.toLowerCase()}
        >
          <div class="card-main">
            <div class="card-badges">
              <span class="badge badge-city">City Emergency</span>
              <span class="badge badge-hours">{contact.available}</span>
            </div>
            <h2>{contact.name}</h2>
            <p class="description">{contact.description}</p>
            {contact.address && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{contact.address}</span>
              </p>
            )}
            {contact.email && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </p>
            )}
          </div>
          <div class="card-action">
            <a
              class="call-btn"
              href={`tel:${contact.dialNumber}`}
              aria-label={`Call ${contact.name} at ${contact.number}`}
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call {contact.number}</span>
            </a>
            <p class="source-credit">
              Source: <a href={contact.source}>{contact.sourceName}</a> ·
              Checked November 3, 2026
            </p>
          </div>
        </article>
      ))}

      <!-- HOSPITALS -->
      {hospitalContacts.map((contact) => (
        <article
          class="contact-card"
          data-category="hospital"
          data-search={`${contact.name} ${contact.description} ${contact.number} hospital trauma emergency room ${contact.address || ""}`.toLowerCase()}
        >
          <div class="card-main">
            <div class="card-badges">
              <span class="badge badge-hospital">Hospital</span>
              <span class="badge badge-hours">{contact.available}</span>
            </div>
            <h2>{contact.name}</h2>
            <p class="description">{contact.description}</p>
            {contact.address && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{contact.address}</span>
              </p>
            )}
            {contact.email && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </p>
            )}
          </div>
          <div class="card-action">
            <a
              class="call-btn"
              href={`tel:${contact.dialNumber}`}
              aria-label={`Call ${contact.name} at ${contact.number}`}
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call {contact.number}</span>
            </a>
            <p class="source-credit">
              Source: <a href={contact.source}>{contact.sourceName}</a> ·
              Checked November 3, 2026
            </p>
          </div>
        </article>
      ))}

      <!-- UTILITY SERVICES -->
      {utilityContacts.map((contact) => (
        <article
          class="contact-card"
          data-category="utility"
          data-search={`${contact.name} ${contact.description} ${contact.number} electricity power water leak outage meralco primewater`.toLowerCase()}
        >
          <div class="card-main">
            <div class="card-badges">
              <span class="badge badge-utility">Utility</span>
              <span class="badge badge-hours">{contact.available}</span>
            </div>
            <h2>{contact.name}</h2>
            <p class="description">{contact.description}</p>
            {contact.address && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{contact.address}</span>
              </p>
            )}
          </div>
          <div class="card-action">
            <a
              class="call-btn"
              href={`tel:${contact.dialNumber}`}
              aria-label={`Call ${contact.name} at ${contact.number}`}
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call {contact.number}</span>
            </a>
            <p class="source-credit">
              Source: <a href={contact.source}>{contact.sourceName}</a> ·
              Checked November 3, 2026
            </p>
          </div>
        </article>
      ))}

      <!-- NATIONAL CONTACTS -->
      {nationalContacts.map((contact) => (
        <article
          class="contact-card"
          data-category="national"
          data-search={`${contact.name} ${contact.description} ${contact.number} national philippines`.toLowerCase()}
        >
          <div class="card-main">
            <div class="card-badges">
              <span class="badge badge-national">National</span>
              <span class="badge badge-hours">{contact.available}</span>
            </div>
            <h2>{contact.name}</h2>
            <p class="description">{contact.description}</p>
          </div>
          <div class="card-action">
            <a
              class="call-btn"
              href={`tel:${contact.dialNumber}`}
              aria-label={`Call ${contact.name} at ${contact.number}`}
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call {contact.number}</span>
            </a>
            <p class="source-credit">
              Source: <a href={contact.source}>{contact.sourceName}</a> ·
              Checked November 3, 2026
            </p>
          </div>
        </article>
      ))}

      <!-- 62 BARANGAYS -->
      {barangayContacts.map((barangay) => (
        <article
          class="contact-card barangay-card"
          data-category="barangay"
          data-district={barangay.district}
          data-search={`barangay ${barangay.name} district ${barangay.district} ${barangay.chairman} ${barangay.phone || ""} ${barangay.email || ""} ${barangay.address || ""}`.toLowerCase()}
        >
          <div class="card-main">
            <div class="card-badges">
              <span class="badge badge-barangay">Barangay</span>
              <span class="badge badge-district">
                District {barangay.district}
              </span>
              {barangay.phone ? (
                <span class="badge badge-verified">Direct Line</span>
              ) : (
                <span class="badge badge-dispatch">Central Dispatch</span>
              )}
            </div>
            <h2>Barangay {barangay.name}</h2>
            <p class="chair-name">
              <strong>Punong Barangay:</strong> {barangay.chairman}
            </p>
            <p class="description">
              {barangay.phone
                ? `Direct barangay hall telephone/mobile hotline for resident inquiries and local tanod response.`
                : `Direct hall line is not published. Emergency response and disaster assistance are coordinated 24/7 through the City Central Trunkline and CDRRMO two-way radio dispatch.`}
            </p>
            {barangay.address && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{barangay.address}</span>
              </p>
            )}
            {barangay.email && (
              <p class="meta-item">
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <a href={`mailto:${barangay.email}`}>{barangay.email}</a>
              </p>
            )}
          </div>
          <div class="card-action">
            {barangay.phone ? (
              <a
                class="call-btn"
                href={`tel:${barangay.dialNumber}`}
                aria-label={`Call Barangay ${barangay.name} at ${barangay.phone}`}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>Call {barangay.phone}</span>
              </a>
            ) : (
              <a
                class="call-btn call-dispatch"
                href="tel:0449197370"
                aria-label={`Call City Central Dispatch for Barangay ${barangay.name}`}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <span>Dispatch: (044) 919-7370</span>
              </a>
            )}
            <p class="source-credit">
              Source: <a href={barangay.source}>{barangay.sourceName}</a> ·
              Checked November 3, 2026
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="noResults" class="no-results" hidden>
      <div class="no-results-icon" aria-hidden="true">
        🔍
      </div>
      <h3>No matching emergency contacts</h3>
      <p>
        No results found for your search term. In an urgent situation, call
        <strong>911</strong> or reach the CDRRMO command center at
        <strong>0955-206-7200</strong>.
      </p>
      <button type="button" id="resetFiltersBtn" class="reset-btn">
        Reset filters and search
      </button>
    </div>

    <!-- Crisis Assistance Banner -->
    <article class="crisis-card">
      <div class="crisis-text">
        <h2>Medical, burial, or disaster crisis assistance (AICS)</h2>
        <p>
          Need financial or food assistance during severe illness, sudden
          hospitalization, or funeral expenses? Read our step-by-step guide to
          the City Social Welfare and Development Office (CSWDO) program.
        </p>
      </div>
      <a class="crisis-link" href="/services/aics-crisis-assistance/">
        View Crisis Assistance Guide
      </a>
    </article>

    <!-- Source and Civic Verification Note -->
    <div class="civic-note">
      <h3>Independent Civic Verification Standard</h3>
      <p>
        Better SJDM is an independent community project and is not an official
        government platform. Contacts are verified directly against official
        City Government directories, the 2026 Citizen's Charter, DILG Bulacan,
        and issuing utility authorities. Unverified personal phone numbers are
        intentionally excluded to prevent misinformation during emergency
        operations. Numbers are periodically rechecked.
      </p>
      <p>
        To verify directly on the official city government portal, visit the{" "}
        <a href="https://csjdm.gov.ph/contact-us/">
          City of San Jose del Monte Directory
        </a>{" "}
        or the{" "}
        <a href="https://csjdm.gov.ph/government/barangay-captains/">
          List of Barangay Captains
        </a>
        .
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  function setupEmergencyDirectory() {
    const searchInput = document.getElementById(
      "emergencySearch",
    ) as HTMLInputElement | null;
    const clearBtn = document.getElementById(
      "clearSearch",
    ) as HTMLButtonElement | null;
    const tabButtons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");
    const subtabButtons =
      document.querySelectorAll<HTMLButtonElement>(".subtab-btn");
    const districtContainer = document.getElementById("districtFilters");
    const cards = document.querySelectorAll<HTMLElement>(".contact-card");
    const noResults = document.getElementById("noResults");
    const resultsCount = document.getElementById("resultsCount");
    const resetBtn = document.getElementById("resetFiltersBtn");

    if (!searchInput || !cards.length) return;

    let activeCategory = "all";
    let activeDistrict = "all";

    function filterCards() {
      const query = (searchInput?.value || "").trim().toLowerCase();
      let visibleCount = 0;

      // Show/hide clear search button
      if (clearBtn) {
        clearBtn.hidden = query.length === 0;
      }

      // Show/hide district filter buttons
      if (districtContainer) {
        const isBarangayActive =
          activeCategory === "barangay" ||
          (activeCategory === "all" && query.includes("barangay"));
        districtContainer.hidden = !isBarangayActive;
      }

      cards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category") || "";
        const cardDistrict = card.getAttribute("data-district") || "";
        const cardSearch = card.getAttribute("data-search") || "";

        // Category check
        const matchesCategory =
          activeCategory === "all" || cardCategory === activeCategory;

        // District check (only relevant if barangay category or if a district is chosen)
        let matchesDistrict = true;
        if (cardCategory === "barangay" && activeDistrict !== "all") {
          matchesDistrict = cardDistrict === activeDistrict;
        }

        // Search query check
        const matchesSearch = query.length === 0 || cardSearch.includes(query);

        const isVisible = matchesCategory && matchesDistrict && matchesSearch;

        if (isVisible) {
          card.style.display = "";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      // Update counter and empty state
      if (resultsCount) {
        if (query.length > 0) {
          resultsCount.textContent = `Found ${visibleCount} contact${visibleCount === 1 ? "" : "s"} for "${query}"`;
        } else if (activeCategory !== "all") {
          resultsCount.textContent = `Showing ${visibleCount} ${activeCategory} contact${visibleCount === 1 ? "" : "s"}`;
        } else {
          resultsCount.textContent = `Showing all ${visibleCount} contacts`;
        }
      }

      if (noResults) {
        noResults.hidden = visibleCount > 0;
      }
    }

    // Search events
    searchInput.addEventListener("input", filterCards);
    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      searchInput.focus();
      filterCards();
    });

    // Reset button
    resetBtn?.addEventListener("click", () => {
      searchInput.value = "";
      activeCategory = "all";
      activeDistrict = "all";

      tabButtons.forEach((btn) => {
        const isAll = btn.getAttribute("data-filter") === "all";
        btn.classList.toggle("active", isAll);
        btn.setAttribute("aria-selected", isAll ? "true" : "false");
      });

      subtabButtons.forEach((btn) => {
        const isAll = btn.getAttribute("data-district") === "all";
        btn.classList.toggle("active", isAll);
        btn.setAttribute("aria-pressed", isAll ? "true" : "false");
      });

      filterCards();
    });

    // Category Tabs
    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabButtons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-selected", "true");

        activeCategory = btn.getAttribute("data-filter") || "all";
        filterCards();
      });
    });

    // District Subtabs
    subtabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        subtabButtons.forEach((b) => {
          b.classList.remove("active");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("active");
        btn.setAttribute("aria-pressed", "true");

        activeDistrict = btn.getAttribute("data-district") || "all";
        filterCards();
      });
    });

    // Initial run
    filterCards();
  }

  // Support Astro view transitions or standard load
  document.addEventListener("DOMContentLoaded", setupEmergencyDirectory);
  if (
    document.readyState === "interactive" ||
    document.readyState === "complete"
  ) {
    setupEmergencyDirectory();
  }
</script>

