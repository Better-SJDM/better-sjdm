---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceSearch from "../components/site/ServiceSearch.astro";
import CityInfo from "../components/site/CityInfo.astro";
const services = (await getCollection("services")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Home">
  <section class="home-intro">
    <div class="hero-orbit hero-orbit-one" aria-hidden="true"></div>
    <div class="hero-orbit hero-orbit-two" aria-hidden="true"></div>
    <div class="intro-inner">
      <div class="intro-copy">
        <h1>Kumusta, San Joseños.</h1>
        <p>
          Find local services and the information you need, together in one
          community guide.
        </p>
        <ServiceSearch services={services} compact />
        <div class="hero-links">
          <a href="/services/">Browse all services</a>
          <a href="/emergency/">Emergency contacts</a>
        </div>
        <p class="project-note">
          Independent community project, not an official city government
          website.
          {services.some(({ data }) => data.sample) &&
            " Listings marked as fictional are examples."}
        </p>
      </div>
      <div class="hero-emblem" aria-hidden="true">
        <img src="/images/better-sjdm-hero.png" alt="" />
      </div>
    </div>
  </section>
  <CityInfo />
  <section class="community">
    <div>
      <h2>Help make this guide useful.</h2>
      <p>
        Know a service residents should be able to find, or noticed something
        that needs correcting? Share a reliable source with the community.
      </p>
      <a href="/about/#contribute">Suggest a service or correction</a>
    </div>
  </section>
</BaseLayout>
<style>
  .home-intro {
    position: relative;
    overflow: hidden;
    background: var(--background-image-civic-soft);
    border-bottom: 1px solid var(--color-stroke);
  }
  .hero-orbit {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-orbit-one {
    width: clamp(18rem, 32vw, 36rem);
    aspect-ratio: 1;
    top: -9rem;
    right: -8rem;
    background: #8ebcf44d;
  }
  .hero-orbit-two {
    width: clamp(13rem, 24vw, 27rem);
    aspect-ratio: 1;
    top: 28rem;
    left: -8rem;
    background: #ffcf5860;
  }
  .intro-inner,
  .community {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .intro-inner {
    position: relative;
    display: grid;
    gap: 2rem;
    padding-block: clamp(3rem, 6vw, 5.5rem);
    align-items: center;
  }
  .intro-copy {
    min-width: 0;
  }
  .intro-copy h1 {
    max-width: 18ch;
    color: var(--color-navy);
    font-family: var(--font-site);
    font-weight: 800;
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .intro-copy > p {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.7;
  }
  .intro-copy .project-note {
    color: var(--color-muted-copy);
    font-size: 0.9rem;
  }
  .intro-inner :global(.search-panel) {
    width: min(100%, 46rem);
    margin-top: 1.5rem;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
  }
  .hero-links a {
    color: var(--color-brand);
    font-weight: 700;
    text-underline-offset: 4px;
  }
  .hero-emblem {
    position: relative;
    width: min(65%, 22rem);
    margin-inline: auto;
  }
  .hero-emblem img {
    position: relative;
    width: 100%;
    height: auto;
  }
  .community {
    padding-block: 4rem;
  }
  .community div {
    max-width: 45rem;
  }
  .community h2 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1.2;
  }
  .community p {
    margin-top: 1rem;
    line-height: 1.7;
  }
  .community a {
    display: inline-block;
    margin-top: 1.2rem;
    color: var(--color-brand);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .home-intro {
      animation: ambient-gradient 20s ease-in-out infinite alternate;
    }
    .hero-orbit-one {
      animation: drift 12s ease-in-out infinite alternate;
    }
    .intro-copy {
      animation: enter 600ms ease-out both;
    }
    .community a {
      transition:
        color 180ms ease,
        text-decoration-color 180ms ease;
    }
    @keyframes enter {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes drift {
      from {
        transform: translateY(-12px);
      }
      to {
        transform: translateY(20px);
      }
    }
    @keyframes ambient-gradient {
      from {
        background-position: 0% 35%;
      }
      to {
        background-position: 100% 65%;
      }
    }
  }
  @media (min-width: 640px) {
    .intro-inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: clamp(1.5rem, 4vw, 4rem);
    }
    .hero-emblem {
      width: min(100%, 22rem);
    }
  }
</style>
