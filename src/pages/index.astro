---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceSearch from "../components/site/ServiceSearch.astro";
import { Button } from "../components/starwind/button";

const services = (await getCollection("services")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="Home">
  <section class="relative overflow-hidden bg-civic">
    <div
      class="pointer-events-none absolute -top-44 -right-36 size-[34rem] rounded-full border border-white/60 bg-white/20 motion-safe:animate-civic-enter"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute top-16 left-[-7rem] size-64 rounded-full bg-sunlight/70 blur-3xl motion-safe:animate-civic-enter motion-safe:[animation-delay:120ms]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute right-[8%] bottom-[-12rem] size-80 rounded-full border-[2rem] border-white/20"
      aria-hidden="true"
    ></div>
    <div class="relative mx-auto grid w-[calc(100%-2rem)] max-w-site items-center gap-8 py-10 min-[521px]:w-[calc(100%-2.5rem)] min-[521px]:gap-10 min-[521px]:py-14 min-[801px]:grid-cols-[1fr_1.05fr] min-[801px]:gap-16 min-[801px]:py-24">
      <div class="max-w-xl">
        <p class="mb-4 flex items-center gap-3 text-xs font-bold tracking-[0.12em] text-brand uppercase">
          <span class="h-0.5 w-6 bg-brand" aria-hidden="true"></span> Welcome to
        </p>
        <h1 class="text-[clamp(2.6rem,5vw,4.25rem)] leading-[1.05] font-extrabold tracking-[-0.045em] text-navy">
          Better SJDM
        </h1>
        <div
          class="mt-5 h-1.5 w-16 rounded-full bg-sunshine"
          aria-hidden="true"
        ></div>
        <p class="mt-4 max-w-md text-base leading-relaxed text-muted-copy min-[521px]:mt-5 min-[521px]:text-lg">
          A community-powered guide to services and information in San Jose del
          Monte, Bulacan.
        </p>
        <div class="mt-6 grid gap-3 min-[420px]:flex min-[420px]:flex-wrap min-[420px]:items-center min-[521px]:mt-8">
          <Button
            as="a"
            variant="primary"
            size="lg"
            class="min-h-12 w-full bg-brand px-6 font-bold text-white hover:bg-brand-hover min-[420px]:w-auto"
            href="/services/"
          >
            Browse services <span aria-hidden="true">→</span>
          </Button>
          <Button
            as="a"
            variant="outline"
            size="lg"
            class="min-h-12 w-full border-stroke bg-white px-6 font-bold text-brand hover:bg-blue-wash min-[420px]:w-auto"
            href="/about/"
          >
            About this project
          </Button>
        </div>
      </div>
      <ServiceSearch services={services} compact />
    </div>
    <div class="relative mx-auto w-[calc(100%-2rem)] max-w-site pb-10 min-[521px]:w-[calc(100%-2.5rem)] min-[801px]:pb-14">
      <div class="grid gap-5 rounded-2xl border border-white/80 bg-white/80 p-6 min-[521px]:p-8 min-[801px]:grid-cols-[1fr_1.05fr] min-[801px]:gap-16">
        <div>
          <p class="text-xs font-bold tracking-[0.1em] text-brand uppercase">
            Built together
          </p>
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-navy">
            A guide shaped by our community
          </h2>
        </div>
        <div class="max-w-xl text-base leading-relaxed text-muted-copy">
          <p>
            Know a useful local service or spotted something that needs fixing?
            Help us build a more useful guide for everyone.
          </p>
          <a
            class="mt-4 inline-block font-bold text-brand underline-offset-4 hover:underline"
            href="/about/#contribute"
          >
            Learn how to contribute
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
