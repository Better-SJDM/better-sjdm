---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">
        <span></span> 404
      </p>
      <h1>
        We couldn't find
        <br />
        <em>that page.</em>
      </h1>
      <p class="page-description">
        Try the homepage or explore the services directory.
      </p>
      <div class="actions">
        <a class="primary-action" href="/">
          Go home →
        </a>
        <a class="text-link" href="/services/">
          Browse services →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--color-stroke);
    background: var(--background-image-civic-soft);
  }
  .container {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-brand);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .eyebrow span {
    width: 27px;
    height: 2px;
    background: var(--color-brand);
  }
  .page-header h1 {
    margin: 1.5rem 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.055em;
  }
  .page-header h1 em {
    color: var(--color-brand);
    font-style: normal;
  }
  .page-description {
    max-width: 31rem;
    color: var(--color-muted-copy);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .text-link {
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 1.25rem;
    border-radius: 0.45rem;
    background: var(--color-brand);
    color: white;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .primary-action:hover {
    background: var(--color-brand-hover);
  }
  @media (min-width: 521px) {
    .page-header {
      padding-block: 4rem;
    }
    .container {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
  }
</style>
