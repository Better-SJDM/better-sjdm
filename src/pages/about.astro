---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="page-header">
    <div class="container">
      <nav class="hero-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">About</span>
      </nav>
      <h1>
        Made for our city,
        <br />
        <em>with our community.</em>
      </h1>
      <p class="page-description">
        A place to make useful information easier to find.
      </p>
    </div>
  </section>
  <section class="content">
    <div class="content-card">
      <h2>A guide built together</h2>
      <p>
        Better SJDM is an independent, community-maintained project for San Jose
        del Monte. It is not an official city government website.
      </p>
      <p>
        Service entries link to their sources and show when their information
        was reviewed. Confirm current details with the responsible office.
      </p>
      <h2>Our city</h2>
      <p>
        San Jose del Monte is a city in Bulacan, Central Luzon. The 2024 census
        counted 685,688 residents across 62 barangays.{" "}
        <a
          class="text-link"
          href="https://psa.gov.ph/classification/psgc/barangays/0301420000"
        >
          Source: Philippine Statistics Authority
        </a>
      </p>
      <h2>A brief history</h2>
      <p>
        The city government traces the municipality’s founding to March 2, 1752.
        The Sapang Palay resettlement area opened in 1961, and San Jose del
        Monte became a component city in 2000.{" "}
        <a
          class="text-link"
          href="https://csjdm.gov.ph/history-of-san-jose-del-monte/"
        >
          Source: City Government history
        </a>
      </p>
      <p>
        In 2023, the former barangay of Muzon was divided into four barangays.{" "}
        <a
          class="text-link"
          href="https://elibrary.judiciary.gov.ph/thebookshelf/showdocs/2/95888"
        >
          Source: Republic Act No. 11896
        </a>
      </p>
      <p>
        <a class="text-link" href="/statistics/">
          Explore city statistics and barangays
        </a>
      </p>
      <h2 id="contribute">Help improve the guide</h2>
      <p>
        Suggest a correction or contribute a sourced service entry through the
        project’s GitHub repository. See the contributor guide in the repository
        for the review process.
      </p>
      <a
        class="text-link"
        href="https://github.com/Better-SJDM/better-sjdm/issues/new/choose"
      >
        Suggest a service or correction
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-stroke);
    background: var(--background-image-civic-soft);
  }
  .container {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-brand);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .eyebrow span {
    width: 27px;
    height: 2px;
    background: var(--color-brand);
  }
  .page-header h1 {
    margin: 0;
    color: var(--color-navy);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .page-header h1 em {
    color: var(--color-brand);
    font-style: normal;
  }
  .page-description {
    max-width: 65ch;
    margin-top: 0.85rem;
    color: var(--color-muted-copy);
    font-size: 1.15rem;
    line-height: 1.6;
  }
  .content {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
    padding: 2rem 0 3.5rem;
  }
  .content-card {
    padding: clamp(1.3rem, 4vw, 2.5rem);
    border: 1px solid var(--color-stroke);
    border-radius: 0.6rem;
    background: var(--background-image-civic-card);
  }
  .content-card h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .content-card h2:not(:first-child) {
    margin-top: 2.5rem;
  }
  .content-card p {
    margin-bottom: 1rem;
    color: var(--color-muted-copy);
    line-height: 1.8;
  }
  .text-link {
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  @media (min-width: 521px) {
    .container {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
    .content {
      width: min(calc(100% - 2.5rem), var(--container-site));
      padding-block: 3rem 5rem;
    }
  }
</style>
