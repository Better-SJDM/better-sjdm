---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="border-b border-stroke bg-civic-soft py-9 min-[521px]:py-16 [&_h1]:my-6 [&_h1]:text-[clamp(2rem,6vw,4rem)] [&_h1]:leading-[1.04] [&_h1]:font-extrabold [&_h1]:tracking-[-0.055em] [&_em]:not-italic [&_em]:text-brand [&>div>p:not(.eyebrow)]:max-w-[31rem] [&>div>p:not(.eyebrow)]:text-[1.05rem] [&>div>p:not(.eyebrow)]:leading-[1.8] [&>div>p:not(.eyebrow)]:text-muted-copy">
    <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)]">
      <p class="eyebrow flex items-center gap-3 text-[0.7rem] font-extrabold tracking-[0.16em] text-brand [&>span]:h-0.5 [&>span]:w-[27px] [&>span]:bg-brand">
        <span></span> ABOUT BETTER SJDM
      </p>
      <h1>
        Made for our city,
        <br />
        <em>with our community.</em>
      </h1>
      <p>A place to make useful information easier to find.</p>
    </div>
  </section>
  <section class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] max-w-[850px] pt-8 pb-14 min-[521px]:pt-12 min-[521px]:pb-20">
    <div class="rounded-[0.6rem] border border-stroke bg-civic-card p-[clamp(1.3rem,4vw,2.5rem)] [&_h2]:mb-4 [&_h2]:text-xl [&_h2]:font-bold [&_p]:mb-4 [&_p]:leading-[1.8] [&_p]:text-muted-copy [&_h2:not(:first-child)]:mt-10">
      <h2>A guide built together</h2>
      <p>
        Better SJDM is an independent, community-maintained project for San Jose
        del Monte. It is not an official city government website.
      </p>
      <p>
        The directory currently contains fictional examples while the project is
        being built. Future entries should link to reliable sources and show
        when they were last verified.
      </p>
      <h2 id="contribute">Help improve the guide</h2>
      <p>
        Suggest a correction or contribute a sourced service entry through the
        project’s GitHub repository. See the contributor guide in the repository
        for the review process.
      </p>
      <p>
        The repository link will be added when the project is published on
        GitHub.
      </p>
      <a
        class="text-sm font-bold text-brand no-underline hover:underline"
        href="/services/"
      >
        Browse example services →
      </a>
    </div>
  </section>
</BaseLayout>
