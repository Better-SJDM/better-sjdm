---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="page-header">
    <div class="container">
      <h1>
        Made for our city,
        <br />
        <em>with our community.</em>
      </h1>
      <p class="page-description">
        A place to make useful information easier to find.
      </p>
    </div>
  </section>
  <section class="content">
    <div class="content-card">
      <h2>A guide built together</h2>
      <p>
        Better SJDM is an independent, community-maintained project for San Jose
        del Monte. It is not an official city government website.
      </p>
      <p>
        The directory currently contains fictional examples while the project is
        being built. Future entries should link to reliable sources and show
        when they were last verified.
      </p>
      <h2 id="contribute">Help improve the guide</h2>
      <p>
        Suggest a correction or contribute a sourced service entry through the
        project’s GitHub repository. See the contributor guide in the repository
        for the review process.
      </p>
      <a
        class="text-link"
        href="https://github.com/Better-SJDM/better-sjdm/issues/new/choose"
      >
        Suggest a service or correction
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--color-stroke);
    background: var(--background-image-civic-soft);
  }
  .container {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-brand);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  .eyebrow span {
    width: 27px;
    height: 2px;
    background: var(--color-brand);
  }
  .page-header h1 {
    margin: 1.5rem 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.055em;
  }
  .page-header h1 em {
    color: var(--color-brand);
    font-style: normal;
  }
  .page-description {
    max-width: 31rem;
    color: var(--color-muted-copy);
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .content {
    width: min(calc(100% - 2rem), 850px);
    margin-inline: auto;
    padding: 2rem 0 3.5rem;
  }
  .content-card {
    padding: clamp(1.3rem, 4vw, 2.5rem);
    border: 1px solid var(--color-stroke);
    border-radius: 0.6rem;
    background: var(--background-image-civic-card);
  }
  .content-card h2 {
    margin-bottom: 1rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .content-card h2:not(:first-child) {
    margin-top: 2.5rem;
  }
  .content-card p {
    margin-bottom: 1rem;
    color: var(--color-muted-copy);
    line-height: 1.8;
  }
  .text-link {
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
  }
  @media (min-width: 521px) {
    .page-header {
      padding-block: 4rem;
    }
    .container {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
    .content {
      width: min(calc(100% - 2.5rem), 850px);
      padding-block: 3rem 5rem;
    }
  }
</style>
