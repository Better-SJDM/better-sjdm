---
import "@/styles/starwind.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "A community-maintained guide to services in San Jose del Monte.",
} = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/", label: "Home", current: path === "/" },
  {
    href: "/services/",
    label: "Services",
    current: path === "/services" || path.startsWith("/services/"),
  },
  { href: "/about/", label: "About", current: path === "/about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title} | Better SJDM</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="topline">
      <div class="topline-inner">
        A community guide for San Jose del Monte{" "}
        <span>Made for neighbors, by neighbors</span>
      </div>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Better SJDM home">
          <span class="brand-image">
            <img src="/images/better-sjdm.png" alt="" />
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <details class="mobile-menu">
          <summary>
            <svg
              class="menu-open-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="menu-close-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
            Menu
          </summary>
          <nav aria-label="Mobile navigation" class="mobile-nav">
            <div class="mobile-nav-inner">
              {links.map((link) => (
                <a
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>Better SJDM</strong>
          <p>A community-maintained guide to San Jose del Monte.</p>
        </div>
        <div>
          <a href="/services/">Services</a>
          <a href="/about/">About &amp; contributing</a>
        </div>
      </div>
      <div class="footer-note">
        Independent community project · Not an official government website
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -5rem;
    left: 1rem;
    z-index: 20;
    padding: 0.75rem;
    background: white;
  }
  .skip-link:focus {
    top: 0.5rem;
  }
  .topline {
    padding: 0.5rem 0;
    background: var(--background-image-civic-nav);
    color: white;
    font-size: 0.72rem;
    letter-spacing: 0.035em;
  }
  .topline-inner,
  .header-inner,
  .footer-inner,
  .footer-note {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .topline-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .topline-inner span {
    display: none;
    color: var(--color-soft-blue);
  }
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-stroke);
    background: white;
    box-shadow: 0 3px 18px #0926570d;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 80px;
    gap: 1rem;
    padding-block: 0.25rem;
  }
  .brand {
    display: block;
    flex: none;
    width: 126px;
    height: 70px;
    overflow: hidden;
  }
  .brand-image {
    position: relative;
    display: block;
    width: 174px;
    height: 96px;
    overflow: hidden;
    transform: scale(0.72);
    transform-origin: top left;
  }
  .brand-image img {
    position: absolute;
    top: -42px;
    left: 0;
    width: 174px;
    max-width: none;
  }
  .desktop-nav {
    display: none;
    gap: 0.25rem;
    align-items: center;
  }
  .desktop-nav a,
  .mobile-nav a {
    text-decoration: none;
    font-weight: 700;
  }
  .desktop-nav a {
    padding: 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"],
  .mobile-nav a:hover,
  .mobile-nav a[aria-current="page"] {
    background: var(--color-blue-wash);
    color: var(--color-brand);
  }
  .mobile-menu summary {
    display: flex;
    align-items: center;
    min-height: 48px;
    gap: 0.5rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-stroke);
    border-radius: 0.5rem;
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary:hover {
    background: var(--color-blue-wash);
  }
  .mobile-menu summary:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .mobile-menu svg {
    width: 20px;
    height: 20px;
  }
  .menu-close-icon,
  .mobile-menu[open] .menu-open-icon {
    display: none;
  }
  .mobile-menu[open] .menu-close-icon {
    display: block;
  }
  .mobile-nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-stroke);
    background: white;
    box-shadow: var(--shadow-panel);
  }
  .mobile-nav-inner {
    display: grid;
    gap: 0.25rem;
    max-width: var(--container-site);
    margin-inline: auto;
  }
  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 1rem;
    border-radius: 0.5rem;
    color: var(--color-navy);
  }
  .site-footer {
    padding: 3rem 0 1.5rem;
    background: var(--color-navy);
    color: white;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }
  .footer-inner strong {
    font-size: 1.125rem;
  }
  .footer-inner p {
    margin: 0.75rem 0;
    color: var(--color-soft-blue);
    font-size: 0.875rem;
  }
  .footer-inner div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-content: start;
  }
  .site-footer a {
    font-size: 0.875rem;
  }
  .footer-note {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-footer-border);
    color: var(--color-soft-blue);
    font-size: 0.75rem;
  }
  @media (min-width: 521px) {
    .topline-inner,
    .header-inner,
    .footer-inner,
    .footer-note {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
    .topline-inner span {
      display: inline;
    }
    .header-inner {
      min-height: 90px;
      padding-block: 0;
    }
    .brand {
      width: 157px;
      height: 87px;
    }
    .brand-image {
      transform: scale(0.9);
    }
    .footer-inner {
      flex-direction: row;
    }
  }
  @media (min-width: 640px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>
