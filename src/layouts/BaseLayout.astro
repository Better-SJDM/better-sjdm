---
import "@/styles/global.css";
import CityInfo from "../components/site/CityInfo.astro";
import { emergencyContacts } from "../data/emergency-contacts";
import chevronIcon from "@tabler/icons/outline/chevron-down.svg?raw";
import servicesIcon from "@tabler/icons/outline/list-details.svg?raw";
import phoneIcon from "@tabler/icons/outline/phone-call.svg?raw";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "A community-maintained guide to services in San Jose del Monte.",
} = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/", label: "Home", current: path === "/" },
  {
    href: "/services/",
    label: "Services",
    current:
      path === "/services" ||
      path.startsWith("/services/") ||
      path === "/emergency",
  },
  {
    href: "/statistics/",
    label: "Statistics",
    current: path === "/statistics",
  },
  { href: "/about/", label: "About", current: path === "/about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title} | Better SJDM</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="topline">
      <div
        class="topline-inner"
        tabindex="0"
        aria-label="Quick access, scroll horizontally for more information"
      >
        <nav class="emergency-nav" aria-label="Emergency assistance">
          <div
            class="contact-slideshow"
            data-contact-slideshow
            aria-label="Important contacts"
          >
            <div class="contact-slides">
              {emergencyContacts.map((contact) => (
                <a
                  data-contact-slide
                  href={`tel:${contact.number.replaceAll("-", "")}`}
                >
                  {contact.name}: {contact.number}
                </a>
              ))}
            </div>
          </div>
        </nav>
        <CityInfo />
      </div>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Better SJDM home">
          <span class="brand-image">
            <img src="/images/better-sjdm.png" alt="" />
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {links.map((link) =>
            link.href === "/services/" ? (
              <div
                class="nav-group"
                data-active={link.current ? "true" : undefined}
              >
                <a
                  href={link.href}
                  aria-current={
                    link.current && path !== "/emergency" ? "page" : undefined
                  }
                >
                  Services{" "}
                  <span
                    class="nav-chevron"
                    aria-hidden="true"
                    set:html={chevronIcon}
                  />
                </a>
                <div class="nav-submenu" aria-label="Services links">
                  <a href="/services/">
                    <span
                      class="nav-icon"
                      aria-hidden="true"
                      set:html={servicesIcon}
                    />
                    <span>
                      All Services<small>Browse the directory</small>
                    </span>
                  </a>
                  <a
                    href="/emergency/"
                    aria-current={path === "/emergency" ? "page" : undefined}
                  >
                    <span
                      class="nav-icon"
                      aria-hidden="true"
                      set:html={phoneIcon}
                    />
                    <span>
                      Emergency Hotline<small>Find emergency numbers</small>
                    </span>
                  </a>
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
              >
                {link.label}
              </a>
            ),
          )}
        </nav>
        <details class="mobile-menu">
          <summary>
            <svg
              class="menu-open-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="menu-close-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
            Menu
          </summary>
          <nav aria-label="Mobile navigation" class="mobile-nav">
            <div class="mobile-nav-inner">
              {links.map((link) =>
                link.href === "/services/" ? (
                  <div class="mobile-service-group">
                    <a
                      href="/services/"
                      aria-current={
                        path === "/services" || path.startsWith("/services/")
                          ? "page"
                          : undefined
                      }
                    >
                      Services
                    </a>
                    <a
                      class="mobile-submenu-link"
                      href="/emergency/"
                      aria-current={path === "/emergency" ? "page" : undefined}
                    >
                      Emergency Hotline
                    </a>
                  </div>
                ) : (
                  <a
                    href={link.href}
                    aria-current={link.current ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                ),
              )}
            </div>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <strong>Better SJDM</strong>
          <p>A community-maintained guide to San Jose del Monte.</p>
        </div>
        <div class="footer-emergency">
          <strong>Emergency contacts</strong>
          {emergencyContacts.map((contact) => (
            <a href={`tel:${contact.number.replaceAll("-", "")}`}>
              {contact.name}: {contact.number}
            </a>
          ))}
          <a href="/emergency/">Sources and emergency contacts</a>
        </div>
        <div>
          <a href="/services/">Services</a>
          <a href="/about/">About &amp; contributing</a>
        </div>
      </div>
      <div class="footer-note">
        Weather data: <a href="https://open-meteo.com/">Open-Meteo</a> (
        <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>,
        temperature rounded) · Exchange rates:{" "}
        <a href="https://github.com/fawazahmed0/exchange-api">Exchange API</a>
        <br />
        Independent community project · Not an official government website
      </div>
    </footer>
  </body>
</html>

<script>
  const slideshow = document.querySelector<HTMLElement>(
    "[data-contact-slideshow]",
  );
  if (slideshow) {
    const slides = [
      ...slideshow.querySelectorAll<HTMLElement>("[data-contact-slide]"),
    ];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    if (slides.length > 1) {
      let index = 0;
      const render = () => {
        slides.forEach((slide, i) => {
          slide.hidden = !reducedMotion.matches && i !== index;
        });
      };
      reducedMotion.addEventListener("change", render);
      window.setInterval(() => {
        if (
          !reducedMotion.matches &&
          !slideshow.matches(":hover") &&
          !slideshow.contains(document.activeElement)
        ) {
          index = (index + 1) % slides.length;
          render();
        }
      }, 8000);
      render();
    }
  }
</script>

<style>
  .skip-link {
    position: absolute;
    top: -5rem;
    left: 1rem;
    z-index: 20;
    padding: 0.75rem;
    background: white;
  }
  .skip-link:focus {
    top: 0.5rem;
  }
  .topline {
    padding: 0.5rem 0;
    background: var(--background-image-civic-nav);
    color: white;
    font-size: 0.72rem;
    letter-spacing: 0.035em;
  }
  .topline-inner,
  .header-inner,
  .footer-inner,
  .footer-note {
    width: min(calc(100% - 2rem), var(--container-site));
    margin-inline: auto;
  }
  .topline-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    gap: clamp(1rem, 2vw, 1.5rem);
    overflow-x: auto;
  }
  .emergency-nav {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 1rem;
    padding-right: 1rem;
    border-right: 1px solid #6d86a8;
    white-space: nowrap;
  }
  .emergency-nav a {
    color: white;
    text-decoration: none;
  }
  .emergency-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .emergency-primary {
    font-weight: 800;
    color: #fff2b3 !important;
    white-space: nowrap;
  }
  .contact-slideshow,
  .contact-slides {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .contact-slides {
    flex-wrap: nowrap;
    font-weight: 400;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-contact-slide]:not([hidden]) {
      animation: contact-appear 350ms ease-out;
    }
    @keyframes contact-appear {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  .all-emergency {
    white-space: nowrap;
  }
  .footer-emergency {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-stroke);
    background: white;
    box-shadow: 0 3px 18px #0926570d;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 80px;
    gap: 1rem;
    padding-block: 0.25rem;
  }
  .brand {
    display: block;
    flex: none;
    width: 126px;
    height: 70px;
    overflow: hidden;
  }
  .brand-image {
    position: relative;
    display: block;
    width: 174px;
    height: 96px;
    overflow: hidden;
    transform: scale(0.72);
    transform-origin: top left;
  }
  .brand-image img {
    position: absolute;
    top: -42px;
    left: 0;
    width: 174px;
    max-width: none;
  }
  .desktop-nav {
    display: none;
    gap: 0.25rem;
    align-items: center;
  }
  .nav-group {
    position: relative;
  }
  .nav-group > a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
  }
  .nav-submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 260px;
    padding: 0.5rem;
    border: 1px solid var(--color-stroke);
    border-radius: 0.6rem;
    background: white;
    box-shadow: 0 10px 28px #0926571c;
  }
  .nav-group:hover .nav-submenu,
  .nav-group:focus-within .nav-submenu {
    display: grid;
  }
  .nav-submenu a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.6rem 0.75rem;
  }
  .nav-submenu small {
    display: block;
    margin-top: 0.15rem;
    color: var(--color-muted-copy);
    font-size: 0.75rem;
    font-weight: 400;
  }
  .nav-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: var(--color-blue-wash);
    color: var(--color-brand);
  }
  .nav-icon :global(svg) {
    width: 19px;
    height: 19px;
  }
  .nav-chevron {
    display: inline-flex;
  }
  .nav-chevron :global(svg) {
    width: 15px;
    height: 15px;
  }

  .mobile-nav .mobile-submenu-link {
    padding-left: 2rem;
    font-weight: 500;
  }
  .desktop-nav a,
  .mobile-nav a {
    text-decoration: none;
    font-weight: 700;
  }
  .desktop-nav a {
    padding: 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
  }
  .nav-group[data-active="true"] > a,
  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"],
  .mobile-nav a:hover,
  .mobile-nav a[aria-current="page"] {
    background: var(--color-blue-wash);
    color: var(--color-brand);
  }
  .mobile-menu summary {
    display: flex;
    align-items: center;
    min-height: 48px;
    gap: 0.5rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-stroke);
    border-radius: 0.5rem;
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary:hover {
    background: var(--color-blue-wash);
  }
  .mobile-menu summary:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .mobile-menu svg {
    width: 20px;
    height: 20px;
  }
  .menu-close-icon,
  .mobile-menu[open] .menu-open-icon {
    display: none;
  }
  .mobile-menu[open] .menu-close-icon {
    display: block;
  }
  .mobile-nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-stroke);
    background: white;
    box-shadow: var(--shadow-panel);
  }
  .mobile-nav-inner {
    display: grid;
    gap: 0.25rem;
    max-width: var(--container-site);
    margin-inline: auto;
  }
  .mobile-nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 1rem;
    border-radius: 0.5rem;
    color: var(--color-navy);
  }
  .site-footer {
    padding: 3rem 0 1.5rem;
    background: var(--color-navy);
    color: white;
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }
  .footer-inner strong {
    font-size: 1.125rem;
  }
  .footer-inner p {
    margin: 0.75rem 0;
    color: var(--color-soft-blue);
    font-size: 0.875rem;
  }
  .footer-inner div:last-child {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-content: start;
  }
  .site-footer a {
    font-size: 0.875rem;
  }
  .footer-note {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-footer-border);
    color: var(--color-soft-blue);
    font-size: 0.75rem;
  }
  @media (min-width: 521px) {
    .topline-inner,
    .header-inner,
    .footer-inner,
    .footer-note {
      width: min(calc(100% - 2.5rem), var(--container-site));
    }
    .header-inner {
      min-height: 90px;
      padding-block: 0;
    }
    .brand {
      width: 157px;
      height: 87px;
    }
    .brand-image {
      transform: scale(0.9);
    }
    .footer-inner {
      flex-direction: row;
    }
  }
  @media (min-width: 640px) {
    .desktop-nav {
      display: flex;
    }
    .mobile-menu {
      display: none;
    }
  }
</style>
