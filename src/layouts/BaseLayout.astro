---
import "@/styles/starwind.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "A community-maintained guide to services in San Jose del Monte.",
} = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title} | Better SJDM</title>
  </head>
  <body>
    <a
      class="absolute -top-20 left-4 z-10 bg-white p-3 focus:top-2"
      href="#main"
    >
      Skip to content
    </a>
    <div class="bg-civic-nav py-2 text-[0.72rem] tracking-[0.035em] text-white [&>div]:flex [&>div]:justify-between [&>div]:gap-4 [&_span]:hidden [&_span]:text-soft-blue min-[521px]:[&_span]:inline">
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)]">
        A community guide for San Jose del Monte{" "}
        <span>Made for neighbors, by neighbors</span>
      </div>
    </div>
    <header class="border-b border-stroke bg-white shadow-[0_3px_18px_#0926570d]">
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] flex min-h-20 flex-wrap items-center justify-between gap-4 py-1 min-[521px]:min-h-[90px] min-[521px]:flex-nowrap min-[521px]:py-0">
        <a
          href="/"
          class="block h-[70px] w-[126px] shrink-0 overflow-hidden min-[521px]:h-[87px] min-[521px]:w-[157px]"
          aria-label="Better SJDM home"
        >
          <span class="relative block h-24 w-[174px] origin-top-left scale-[0.72] overflow-hidden min-[521px]:scale-[0.9] [&_img]:absolute [&_img]:-top-[42px] [&_img]:left-0 [&_img]:w-[174px] [&_img]:max-w-none">
            <img src="/images/better-sjdm.png" alt="" />
          </span>
        </a>
        <nav
          class="flex items-center gap-0 min-[521px]:gap-1 [&_a]:rounded-md [&_a]:px-3 [&_a]:py-3 [&_a]:text-sm [&_a]:font-bold [&_a]:no-underline [&_a:hover]:bg-blue-wash [&_a[aria-current=page]]:bg-blue-wash [&_a[aria-current=page]]:text-brand"
          aria-label="Main navigation"
        >
          <a href="/" aria-current={path === "/" ? "page" : undefined}>
            Home
          </a>
          <a
            href="/services/"
            aria-current={
              path === "/services" || path.startsWith("/services/")
                ? "page"
                : undefined
            }
          >
            Services
          </a>
          <a
            href="/about/"
            aria-current={path === "/about" ? "page" : undefined}
          >
            About
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="bg-navy pt-12 pb-6 text-white [&_a]:text-sm [&_p]:my-3 [&_p]:text-sm [&_p]:text-soft-blue">
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] flex flex-col justify-between gap-8 min-[521px]:flex-row [&_strong]:text-lg [&>div:last-child]:flex [&>div:last-child]:flex-wrap [&>div:last-child]:content-start [&>div:last-child]:gap-6">
        <div>
          <strong>Better SJDM</strong>
          <p>A community-maintained guide to San Jose del Monte.</p>
        </div>
        <div>
          <a href="/services/">Services</a>
          <a href="/about/">About &amp; contributing</a>
        </div>
      </div>
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] mt-8 border-t border-footer-border pt-5 text-xs text-soft-blue">
        Independent community project · Not an official government website
      </div>
    </footer>
  </body>
</html>
