---
import "@/styles/starwind.css";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "A community-maintained guide to services in San Jose del Monte.",
} = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/", label: "Home", current: path === "/" },
  {
    href: "/services/",
    label: "Services",
    current: path === "/services" || path.startsWith("/services/"),
  },
  { href: "/about/", label: "About", current: path === "/about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <title>{title} | Better SJDM</title>
  </head>
  <body>
    <a
      class="absolute -top-20 left-4 z-10 bg-white p-3 focus:top-2"
      href="#main"
    >
      Skip to content
    </a>
    <div class="bg-civic-nav py-2 text-[0.72rem] tracking-[0.035em] text-white [&>div]:flex [&>div]:justify-between [&>div]:gap-4 [&_span]:hidden [&_span]:text-soft-blue min-[521px]:[&_span]:inline">
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)]">
        A community guide for San Jose del Monte{" "}
        <span>Made for neighbors, by neighbors</span>
      </div>
    </div>
    <header class="relative z-10 border-b border-stroke bg-white shadow-[0_3px_18px_#0926570d]">
      <div class="mx-auto flex min-h-20 w-[calc(100%-2rem)] max-w-site items-center justify-between gap-4 py-1 min-[521px]:min-h-[90px] min-[521px]:w-[calc(100%-2.5rem)] min-[521px]:py-0">
        <a
          href="/"
          class="block h-[70px] w-[126px] shrink-0 overflow-hidden min-[521px]:h-[87px] min-[521px]:w-[157px]"
          aria-label="Better SJDM home"
        >
          <span class="relative block h-24 w-[174px] origin-top-left scale-[0.72] overflow-hidden min-[521px]:scale-[0.9] [&_img]:absolute [&_img]:-top-[42px] [&_img]:left-0 [&_img]:w-[174px] [&_img]:max-w-none">
            <img src="/images/better-sjdm.png" alt="" />
          </span>
        </a>
        <nav
          class="hidden items-center gap-1 min-[640px]:flex [&_a]:rounded-md [&_a]:px-3 [&_a]:py-3 [&_a]:text-sm [&_a]:font-bold [&_a]:no-underline [&_a:hover]:bg-blue-wash [&_a[aria-current=page]]:bg-blue-wash [&_a[aria-current=page]]:text-brand"
          aria-label="Main navigation"
        >
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
        <details class="group min-[640px]:hidden">
          <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-lg border border-stroke px-3 text-sm font-bold text-brand hover:bg-blue-wash focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus [&::-webkit-details-marker]:hidden">
            <svg
              class="size-5 group-open:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
              class="hidden size-5 group-open:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
            Menu
          </summary>
          <nav
            aria-label="Mobile navigation"
            class="absolute inset-x-0 top-full border-b border-stroke bg-white px-4 py-3 shadow-panel"
          >
            <div class="mx-auto grid max-w-site gap-1">
              {links.map((link) => (
                <a
                  class:list={[
                    "flex min-h-12 items-center rounded-lg px-4 text-base font-semibold text-navy no-underline hover:bg-blue-wash",
                    { "bg-blue-wash text-brand": link.current },
                  ]}
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="bg-navy pt-12 pb-6 text-white [&_a]:text-sm [&_p]:my-3 [&_p]:text-sm [&_p]:text-soft-blue">
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] flex flex-col justify-between gap-8 min-[521px]:flex-row [&_strong]:text-lg [&>div:last-child]:flex [&>div:last-child]:flex-wrap [&>div:last-child]:content-start [&>div:last-child]:gap-6">
        <div>
          <strong>Better SJDM</strong>
          <p>A community-maintained guide to San Jose del Monte.</p>
        </div>
        <div>
          <a href="/services/">Services</a>
          <a href="/about/">About &amp; contributing</a>
        </div>
      </div>
      <div class="mx-auto w-[calc(100%-2rem)] max-w-site min-[521px]:w-[calc(100%-2.5rem)] mt-8 border-t border-footer-border pt-5 text-xs text-soft-blue">
        Independent community project · Not an official government website
      </div>
    </footer>
  </body>
</html>
