---
import type { CollectionEntry } from "astro:content";
interface Props {
  services: CollectionEntry<"services">[];
  compact?: boolean;
}
const { services, compact = false } = Astro.props;
const categories = [
  ...new Set(services.map(({ data }) => data.category)),
].sort();
---

<div class:list={["search-panel", { compact }]} data-service-search>
  {!compact && <h2>Find a service</h2>}
  <label
    class:list={{ "visually-hidden": compact }}
    for={compact ? "home-search" : "directory-search"}
  >
    {compact ? "Search services" : "Search by name, description, or category"}
  </label>
  <form class="search-form" action="/services/" role="search">
    <input
      id={compact ? "home-search" : "directory-search"}
      type="search"
      name="q"
      autocomplete="off"
      placeholder={compact ? "Search for a service" : "Type a word to search"}
    />
    {compact && <button type="submit">Find a service</button>}
  </form>
  {categories.length > 0 && (
    <div class="categories">
      <h3>{compact ? "Browse by category:" : "Browse by category"}</h3>
      <div class="category-list">
        {categories.map((category) => (
          <a href={`/services/?q=${encodeURIComponent(category)}`}>
            {category}
          </a>
        ))}
      </div>
    </div>
  )}
  <p
    class="results-label"
    aria-live="polite"
    data-results-label
    hidden={compact}
  >
    {services.length
      ? `${services.length} ${services.length === 1 ? "service" : "services"}`
      : "No services yet"}
  </p>
  <div class="results" data-search-results hidden={compact}>
    {services.map(({ id, data }) => (
      <a
        class="result"
        href={`/services/${id}/`}
        data-service-item
        data-search={`${data.title} ${data.description} ${data.category} ${(data.keywords ?? []).join(" ")}`.toLowerCase()}
      >
        <strong>{data.title}</strong>
        <span>
          {data.category}
          {data.sample && " · Fictional example"}
        </span>
        {!compact && <span>{data.description}</span>}
      </a>
    ))}
  </div>
  <p class="empty" hidden>
    No services match your search. Try another word or browse a category.
  </p>
</div>
<script>
  import "../../scripts/service-search";
</script>
<style>
  .search-panel {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: white;
    border: 1px solid #c8d1dc;
    border-radius: 1.25rem;
    box-shadow: 0 14px 36px #09265714;
  }
  .search-panel.compact {
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .compact label {
    font-weight: 700;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .compact .search-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: stretch;
  }
  .compact input {
    flex: 1 1 15rem;
    width: auto;
    min-width: 0;
    min-height: 58px;
    margin: 0;
    padding-inline: 1.1rem;
    border-color: #8da6c7;
    box-shadow: 0 8px 24px #09265712;
  }
  .search-form button {
    min-height: 48px;
    padding: 0.75rem 1.2rem;
    border: 0;
    border-radius: 0.65rem;
    background: var(--color-brand);
    color: white;
    font-weight: 700;
    cursor: pointer;
  }
  .search-form button:hover {
    background: var(--color-brand-hover);
  }
  .compact .categories {
    margin-top: 1rem;
  }
  .compact .results {
    background: white;
    border-radius: 0.75rem;
    padding-inline: 1rem;
  }
  h2 {
    font-size: 1.55rem;
    line-height: 1.2;
  }
  label {
    display: block;
    margin-top: 1rem;
    font-size: 1rem;
  }
  input {
    display: block;
    width: 100%;
    min-height: 48px;
    margin-top: 0.5rem;
    padding: 0.7rem;
    border: 1px solid #718096;
    border-radius: 0.65rem;
    color: var(--color-ink);
    background: white;
  }
  .categories {
    margin-top: 1.5rem;
  }
  h3 {
    font-size: 1rem;
  }
  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .category-list a,
  .all-link {
    color: var(--color-brand);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .category-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    border: 1px solid #c2d4ea;
    border-radius: 0.65rem;
    background: #f3f7fd;
    text-decoration: none;
  }
  .category-list a:hover {
    background: #e4effc;
    border-color: var(--color-brand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .search-panel.compact {
      animation: panel-enter 650ms ease-out both;
    }
    .category-list a,
    .result {
      transition:
        background-color 180ms ease,
        border-color 180ms ease;
    }
    @keyframes panel-enter {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
  .results-label {
    margin-top: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #aeb9c6;
    font-weight: 700;
  }
  .result {
    display: block;
    min-height: 48px;
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid #d5dce4;
    border-radius: 0.5rem;
  }
  .result:hover {
    background: #f3f7fd;
  }
  .result:hover strong {
    text-decoration: underline;
  }
  .result strong {
    color: var(--color-brand);
  }
  .result span {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted-copy);
    font-size: 0.95rem;
  }
  .empty {
    margin-top: 1rem;
  }
  .all-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    margin-top: 1.25rem;
    padding: 0.75rem 1.2rem;
    border-radius: 0.65rem;
    background: var(--color-brand);
    color: white;
    text-decoration: none;
  }
  .all-link:hover {
    background: var(--color-brand-hover);
  }
</style>
