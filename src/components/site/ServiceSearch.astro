---
import type { CollectionEntry } from "astro:content";

interface Props {
  services: CollectionEntry<"services">[];
  compact?: boolean;
}
const { services, compact = false } = Astro.props;
const categories = [
  ...new Set(services.map(({ data }) => data.category)),
].sort();
---

<div class:list={["search-panel", { compact }]} data-service-search>
  <h2 class="search-heading">
    {compact ? "Search services" : "Find a service"}
  </h2>
  <label
    class="visually-hidden"
    for={compact ? "home-search" : "directory-search"}
  >
    Search services
  </label>
  <div class="search-field">
    <svg
      aria-hidden="true"
      class="search-icon"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      viewBox="0 0 24 24"
    >
      <circle cx="10.5" cy="10.5" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
    <input
      id={compact ? "home-search" : "directory-search"}
      type="search"
      placeholder="Search by name or category"
      autocomplete="off"
    />
  </div>

  {compact && categories.length > 0 && (
    <div class="categories">
      <h3 class="categories-heading">Browse categories</h3>
      <div class="categories-grid">
        {categories.map((category) => (
          <a
            class="category-link"
            href={`/services/?q=${encodeURIComponent(category)}`}
          >
            <span class="category-icon" aria-hidden="true">
              <svg
                class="category-svg"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                {category === "Health & wellness" ? (
                  <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9Z" />
                ) : category === "Permits & documents" ? (
                  <>
                    <path d="M7 3h7l4 4v14H7z" />
                    <path d="M14 3v5h4M10 12h5M10 16h5" />
                  </>
                ) : (
                  <>
                    <circle cx="12" cy="8" r="3" />
                    <path d="M5 20v-1a7 7 0 0 1 14 0v1M5 12a3 3 0 0 0-2 3M19 12a3 3 0 0 1 2 3" />
                  </>
                )}
              </svg>
            </span>
            {category}
          </a>
        ))}
      </div>
    </div>
  )}

  <p class="results-label" aria-live="polite" data-results-label>
    {compact ? "Example services" : `${services.length} services`}
  </p>
  <div class="results">
    {services.map(({ id, data }) => (
      <a
        class="result-link"
        href={`/services/${id}/`}
        data-service-item
        data-search={`${data.title} ${data.description} ${data.category}`.toLowerCase()}
      >
        <span class="result-content">
          <strong class="result-title">{data.title}</strong>
          <span class="result-category">
            {data.category}
            {data.sample && " · Fictional example"}
          </span>
          {!compact && (
            <span class="result-description">{data.description}</span>
          )}
        </span>
        <span class="result-arrow" aria-hidden="true">
          →
        </span>
      </a>
    ))}
  </div>
  <p class="empty" hidden>
    No services match your search. Try another word.
  </p>
  {compact && (
    <a class="all-link" href="/services/">
      View all services
    </a>
  )}
</div>
<script>
  import "../../scripts/service-search";
</script>

<style>
  .search-panel {
    padding: 1.25rem;
    border: 1px solid var(--color-stroke);
    border-radius: 1rem;
    background: white;
    box-shadow: var(--shadow-panel);
  }
  .search-panel.compact {
    border-top: 3px solid var(--color-brand);
  }
  .search-heading {
    color: var(--color-navy);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--color-input-border);
    border-radius: 0.5rem;
    color: var(--color-muted-copy);
  }
  .search-field:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .search-field input {
    width: 100%;
    padding: 0.75rem 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1rem;
  }
  .search-field input:focus {
    outline: none;
  }
  .search-icon,
  .category-svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .categories,
  .results-label {
    margin-top: 1.5rem;
  }
  .categories-heading,
  .results-label {
    color: var(--color-muted-copy);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }
  .categories-grid,
  .results {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .category-link {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 56px;
    gap: 0.75rem;
    padding: 0.75rem;
    border: 1px solid var(--color-stroke);
    border-radius: 0.75rem;
    background: var(--background-image-civic-card);
    color: var(--color-navy);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .category-link:hover,
  .result-link:hover {
    border-color: var(--color-brand);
  }
  .category-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 0.5rem;
    background: var(--color-blue-wash);
    color: var(--color-brand);
  }
  .result-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-stroke);
    border-radius: 0.5rem;
    text-decoration: none;
  }
  .result-link:hover {
    background: var(--color-surface-hover);
  }
  .result-content {
    min-width: 0;
  }
  .result-title {
    display: block;
    color: var(--color-navy);
    font-size: 0.875rem;
  }
  .result-category,
  .result-description {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-muted-copy);
    font-size: 0.75rem;
  }
  .result-description {
    font-size: 0.875rem;
  }
  .result-arrow {
    flex-shrink: 0;
    color: var(--color-brand);
  }
  .empty {
    margin-top: 1rem;
    color: var(--color-muted-copy);
    font-size: 0.875rem;
  }
  .all-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 700;
    text-underline-offset: 4px;
  }
  .all-link:hover {
    text-decoration: underline;
  }
  @media (min-width: 420px) {
    .categories-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .category-link {
      flex-direction: column;
      justify-content: center;
      min-height: 96px;
      gap: 0.5rem;
      text-align: center;
    }
  }
  @media (min-width: 640px) {
    .search-panel.compact {
      padding: 1.5rem;
    }
    .search-panel:not(.compact) {
      padding: 2rem;
    }
    .categories-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
